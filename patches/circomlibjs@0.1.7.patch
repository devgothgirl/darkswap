new file mode 100644
--- /dev/null
+++ b/src/ethers-utils.cjs
@@ -0,0 +1,10 @@
+'use strict';
+// circomlibjs uses only these hashing/encoding utilities, never ECDSA.
+// Import the original utilities without ethers' vulnerable signing graph.
+exports.ethers = {
+  utils: {
+    ...require('@ethersproject/bytes'),
+    ...require('@ethersproject/keccak256'),
+    ...require('@ethersproject/strings')
+  }
+};
