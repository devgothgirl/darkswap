# DarkSwap shielded pool: EVM testnet deployment settings (TESTNET).
#
# Copy this file to scripts/.env.deploy, fill it in, then run from the
# package folder:   npm run deploy:evm
# (or: bash scripts/deploy-evm.sh scripts/.env.deploy)
#
# scripts/.env.deploy is ignored by git. It holds a private key: never commit
# it, never paste it into chat, email or a ticket. Delete it when you are done.
# Run the script once per chain: once with a Sepolia RPC URL, once with a
# Base Sepolia RPC URL. Everything else can stay the same.

# The network to deploy to. Use an RPC URL for Sepolia (chain id 11155111) or
# Base Sepolia (chain id 84532). Public endpoints work for a deployment:
#   Sepolia:      https://ethereum-sepolia-rpc.publicnode.com
#   Base Sepolia: https://sepolia.base.org
RPC_URL=

# The DEPLOYER wallet: a throwaway wallet that only pays for the deployment.
# Private key as 0x + 64 hex characters. It must hold testnet ETH on the
# chain above (about 0.05 ETH is plenty). This wallet is NOT the owner, NOT
# the fee recipient and NOT the relayer.
DEPLOYER_PRIVATE_KEY=

# The OWNER: the address that will control the pool (list assets, change
# limits, pause deposits during the guardian window). Required. Must be
# different from the deployer. After the deployment the owner has to call
# acceptOwnership() once on the pool (the manual shows how).
OWNER=

# The FEE RECIPIENT: where swept protocol fees go. Required. FIXED FOREVER:
# the contract has no way to change it. Must be the SAME address on Sepolia
# and Base Sepolia. Must be different from the deployer.
FEE_RECIPIENT=

# Protocol fee on shields and unshields, in basis points (1 bps = 0.01%).
# 50 = 0.5%. The contract allows at most 100 (1%). Can be changed later by the owner.
# Owner decision, 2026-10-04: 50 on all three testnets. Reasoning and the
# competitor comparison it came from: docs/pool-earnings-models.md section 5.
PROTOCOL_FEE_BPS=50

# Days during which the owner can pause deposits. After that, pausing is off forever.
GUARDIAN_DAYS=30

# ETH deposit limits, in wei (1 ETH = 1000000000000000000 wei).
ETH_MIN_DEPOSIT=1000000000000000      # 0.001 ETH: smallest deposit
ETH_MAX_DEPOSIT=1000000000000000000   # 1 ETH: largest single deposit
ETH_CAP=10000000000000000000          # 10 ETH: most the pool will hold

# Also deploy and list a 6-decimal test token ("tUSD")? true or false.
# The deployer wallet receives 1,000,000,000 tUSD to hand out for testing.
TEST_TOKEN=true

# Chainalysis sanctions oracle address, or leave empty for none (testnet).
SANCTIONS_LIST=
