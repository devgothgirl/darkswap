    "@workspace/api-client-react": "workspace:*",
    "@workspace/darkswap-design-system": "workspace:*",
    "date-fns": "^3.6.0",
    "framer-motion": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
