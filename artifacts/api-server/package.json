{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:order-recovery": "bash scripts/test-order-recovery.sh",
    "test:marketing-health": "bash scripts/test-marketing-health.sh",
    "test:support-delivery": "bash scripts/test-support-delivery.sh",
    "support:retention": "pnpm --dir ../../scripts exec tsx ../artifacts/api-server/src/operators/support-retention-cli.ts",
    "pool:export-volumes": "pnpm --dir ../../scripts exec tsx ../artifacts/api-server/src/operators/pool-volume-export.ts",
    "test:pool-volumes": "bash scripts/test-pool-volumes.sh",
    "test:pool-indexer": "bash scripts/test-pool-indexer-evm.sh",
    "test:pool-indexer-solana": "bash scripts/test-pool-indexer-solana.sh",
    "test:rewards": "bash scripts/test-rewards-concurrency.sh",
    "test:launch-private": "bash scripts/test-launch-private.sh",
    "test:docs-fee": "bash scripts/test-docs-fee.sh"
  },
  "dependencies": {
    "@darkswap/pool-client": "workspace:*",
    "@google-cloud/storage": "^8.2.0",
    "@privy-io/server-auth": "^1.32.5",
    "@replit/connectors-sdk": "^0.4.3",
    "@solana/web3.js": "^1.99.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bs58": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "viem": "^2.57.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
